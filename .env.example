# Local development (matches docker-compose.yml)
DATABASE_URL="postgresql://planner:planner@localhost:5432/planner"

# Production: the Neon *pooled* connection string, set in the Vercel dashboard rather than
# in a file. Serverless functions open a connection per invocation, so the pooled endpoint
# (the host containing "-pooler") is the one to use.
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/planner?sslmode=require"

# Migrations only, and only needed in Vercel. Neon's *direct* (unpooled) string — the same
# host without "-pooler". Schema changes are DDL in a transaction, which is exactly what a
# transaction-mode pooler handles badly; `ALTER TYPE ... ADD VALUE` is the one that bites.
# Left unset locally, where DATABASE_URL already points straight at Postgres.
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/planner?sslmode=require"

# Shared secret for POST /api/agent/* (Authorization: Bearer …). Required for agent tools.
# Generate with: openssl rand -hex 32
# PLANNER_AGENT_API_KEY=

# Shared secret for POST /api/agent/* (Authorization: Bearer …). Required for agent tools.
# Generate with: openssl rand -hex 32
# PLANNER_AGENT_API_KEY=
