# Local development (matches docker-compose.yml)
DATABASE_URL="postgresql://planner:planner@localhost:5432/planner"

# Production: the Neon *pooled* connection string, set in the Vercel dashboard rather than
# in a file. Serverless functions open a connection per invocation, so the pooled endpoint
# (the host containing "-pooler") is the one to use.
# The driver is node-postgres, for which `verify-full` is what `require` already does (it
# verifies the certificate, and warns when the string says `require`).
# DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/planner?sslmode=verify-full"

# Migrations only, and only needed in Vercel. Neon's *direct* (unpooled) string — the same
# host without "-pooler". Schema changes are DDL in a transaction, which is exactly what a
# transaction-mode pooler handles badly; `ALTER TYPE ... ADD VALUE` is the one that bites.
# Left unset locally, where DATABASE_URL already points straight at Postgres.
# DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/planner?sslmode=verify-full"

# Better Auth (required for login). Generate secret with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-chars"
# Public origin of the app (no trailing slash). Local default matches npm run dev port.
BETTER_AUTH_URL="http://localhost:3047"

# The local test account, provisioned by npm run db:seed. Sign-up is disabled in the app;
# real accounts are created with:
#   npm run user:create -- --email you@example.com --password 'a-strong-password'
# Leave these unset and the dev account is test@example.com / password12345678 — which is
# the point. An unset variable must never resolve to an account holding real data.
# AUTH_DEV_USER_EMAIL="test@example.com"
# AUTH_DEV_USER_PASSWORD="password12345678"
# AUTH_DEV_USER_NAME="Test User"
# Credentials only, no sample outline: SEED_SAMPLE_DATA=0 npm run db:seed

# Local development only: skip the login screen and serve every request as the *dev* account
# above — never the owner or agent account. Ignored entirely in a production build
# (see src/lib/auth/dev-bypass.ts).
# AUTH_DEV_BYPASS="true"

# Google Calendar + Contacts sync. Optional — without both halves the Connect button on /settings
# reports itself unavailable and the rest of the app is unaffected.
#
# Google Cloud Console → new project → enable the Google Calendar API and People API → OAuth consent
# screen (External, add yourself as a test user) → Credentials → OAuth client ID
# (Web application), with this authorised redirect URI:
#   http://localhost:3047/api/auth/callback/google
# and the deployed origin's equivalent for production.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# Shared secret for POST /api/agent/* and POST /api/mcp (Authorization: Bearer …).
# Generate with: openssl rand -hex 32
# PLANNER_AGENT_API_KEY=
# Account the agent key acts as. REQUIRED in production — agent requests fail rather than
# guess an account. Locally it falls back to AUTH_DEV_USER_EMAIL (the test account).
# PLANNER_AGENT_USER_EMAIL=

# Live bank sync (SimpleFIN). Nothing to configure here.
#
# Unlike an app-wide API key, SimpleFIN credentials are per-user: you connect your banks at
# https://beta-bridge.simplefin.org/, paste the one-time setup token into Settings →
# Connections, and the server exchanges it for an access URL stored in the database. There
# is no environment variable to set, and no third-party script runs in the page.

# Reminders and push notifications
# (agent-os/specs/2026-10-28-2101-reminders-and-push-notifications/). All optional locally:
# without them reminders still collect in the Reminders panel, and
# `npm run reminders:fire-due -- --watch` fires due ones against the local database.
#
# Web Push. Generate a pair with: npx web-push generate-vapid-keys
# The subject is a contact for the push services — mailto: or https:.
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT="mailto:you@example.com"
#
# Upstash QStash calls POST /api/reminders/fire at each reminder's minute (console.upstash.com
# → QStash). Set these on Vercel's **Production** environment only: preview deployments share
# the production database and would otherwise schedule callbacks of their own.
# QSTASH_TOKEN=
# QSTASH_CURRENT_SIGNING_KEY=
# QSTASH_NEXT_SIGNING_KEY=
#
# Vercel Cron sends this as a Bearer token to GET /api/cron/reminders (vercel.json).
# Generate with: openssl rand -hex 32
# CRON_SECRET=
