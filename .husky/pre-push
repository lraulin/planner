# The full suite, including the integration tests that need `npm run db:up`.
#
# Push is the right boundary for these: pre-commit stays fast and Docker-independent,
# but nothing reaches origin without the database-backed mutation tests having run. If
# Postgres is unreachable they skip loudly rather than failing — see
# src/lib/testing/database.ts for why that tradeoff is deliberate. scripts/gate.sh stays
# silent on success but always lets that skip warning through.
bash scripts/gate.sh "tests" npm test
