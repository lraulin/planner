{
  "permissions": {
    "allow": [
      "Bash(git ls-remote *)",
      "Bash(security find-generic-password -s planner-production-backup-database-url -w)"
    ]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-changed.sh\"",
            "timeout": 120,
            "statusMessage": "Linting changed files…"
          }
        ]
      }
    ]
  }
}
