{
  "permissions": {
    "allow": [
      "Bash(git ls-remote *)",
      "Bash(security find-generic-password -s planner-production-backup-database-url -w)",
      "Bash(npx tsx scripts/prod.ts read *)",
      "Bash(npx tsx scripts/prod.ts branch scripts/*)"
    ],
    "ask": ["Bash(npx tsx scripts/prod.ts apply scripts/*)"]
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/lint-changed.sh\"",
            "timeout": 120,
            "statusMessage": "Linting changed files…"
          }
        ]
      }
    ]
  }
}
