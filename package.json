{
  "name": "planner",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3047",
    "build": "node scripts/migrate-on-deploy.mjs && next build",
    "start": "next start -p 3047",
    "lint": "eslint --max-warnings=0",
    "lint:fix": "eslint --fix --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "agent:docs": "tsx scripts/generate-agent-docs.ts",
    "agent:docs:check": "tsx scripts/generate-agent-docs.ts --check",
    "amazon:slim": "tsx scripts/amazon-orders-slim.ts",
    "flow:audit": "tsx --env-file=.env.local scripts/flow-audit.ts",
    "payee:audit": "tsx --env-file=.env.local scripts/payee-merge-audit.ts",
    "backup:setup": "tsx scripts/backup.ts setup",
    "backup:run": "tsx scripts/backup.ts run",
    "backup:status": "tsx scripts/backup.ts status",
    "backup:restore-test": "tsx scripts/backup.ts restore-test",
    "backup:uninstall": "tsx scripts/backup.ts uninstall",
    "smoke": "node scripts/smoke.mjs",
    "smoke:agent": "node --env-file=.env.local scripts/smoke-agent.mjs",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run --project unit --no-isolate",
    "test:integration": "vitest run --project integration --poolOptions.forks.maxForks=8",
    "test:watch": "vitest",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --env-file=.env.local src/db/seed.ts",
    "user:create": "tsx --env-file=.env.local src/db/create-user.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@fullcalendar/core": "^6.1.21",
    "@fullcalendar/daygrid": "^6.1.21",
    "@fullcalendar/interaction": "^6.1.21",
    "@fullcalendar/react": "^6.1.21",
    "@fullcalendar/timegrid": "^6.1.21",
    "@tanstack/react-virtual": "^3.14.10",
    "better-auth": "^1.7.2",
    "d3-sankey": "^0.12.3",
    "drizzle-orm": "^0.45.2",
    "next": "16.3.3",
    "postgres": "^3.4.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "remark-gfm": "^4.0.1",
    "unpdf": "^1.8.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-sankey": "^0.12.5",
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.2.3",
    "drizzle-kit": "^0.31.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.6.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.12",
    "typescript": "^5",
    "typescript-eslint": "^8.67.0",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
